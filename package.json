{
  "name": "sliccy-release-tools",
  "private": true,
  "scripts": {
    "release": "semantic-release",
    "test": "node --test Tests/Release/*.test.mjs && python3 -m unittest discover -s Tests/Release -p 'test_*.py' && npm run test:automation",
    "lint": "biome check .",
    "lint:workflows": "actionlint",
    "test:automation": "node --test Tests/Automation/*.test.mjs",
    "hooks:install": "lefthook install"
  },
  "engines": {
    "node": ">=24.10.0"
  },
  "devDependencies": {
    "@ai-ecoverse/slicc-shared-web": "2.16.1",
    "@biomejs/biome": "2.6.8",
    "conventional-changelog-conventionalcommits": "9.3.1",
    "lefthook": "2.2.2",
    "semantic-release": "25.0.9"
  }
}
